# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env for local development.
# In Railway, set each key directly in the service's Variables tab.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local:        mongodb://localhost:27017
# Railway prod: mongodb://mongo:<pass>@mongodb.railway.internal:27017
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=travel_ai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET=change-refresh-secret-in-production

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=travel-ai
LANGSMITH_TRACING=false

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:        http://localhost:3000
# Railway prod: https://frontend-production-cd15.up.railway.app
FRONTEND_URL=http://localhost:3000
